---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Your Experience Dashboard | Bean & Dream";
---

<BaseLayout title={title}>
<div class="max-w-5xl mx-auto px-4 py-12 space-y-12">
  <header class="flex justify-between items-end">
    <div class="space-y-2">
      <h1 class="text-4xl font-bold tracking-tight">Client Dashboard</h1>
      <p class="text-muted-foreground">Review your bespoke catering requests and finalize your event.</p>
    </div>
    <div class="text-right">
      <span class="text-xs uppercase tracking-widest opacity-60">Client Status</span>
      <div class="font-medium">Verified Lead</div>
    </div>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <!-- Saved Quotes Section -->
    <section class="md:col-span-2 space-y-6">
      <h2 class="text-xl font-semibold">Your Saved Quotes</h2>
      
      <div class="p-6 border border-muted rounded-2xl bg-card space-y-4">
        <div class="flex justify-between items-start">
          <div>
            <h3 class="font-bold text-lg">Premium Mobile Coffee Experience</h3>
            <p class="text-sm opacity-60">Created on Oct 24, 2026</p>
          </div>
          <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full">Draft</span>
        </div>

        <div class="grid grid-cols-2 gap-4 text-sm py-4 border-y border-muted">
          <div>
            <span class="block opacity-60">Guests</span>
            <span class="font-medium">50</span>
          </div>
          <div>
            <span class="block opacity-60">Base Tier</span>
            <span class="font-medium">The Alchemist's Suite</span>
          </div>
          <div>
            <span class="block opacity-60">Estimate</span>
            <span class="font-bold text-lg">$1,450.00</span>
          </div>
          <div>
            <span class="block opacity-60">Status</span>
            <span class="font-medium text-green-500">Ready for Review</span>
          </div>
        </div>

        <div class="flex gap-3">
          <button class="flex-1 py-2 px-4 bg-primary text-primary-foreground font-semibold rounded-lg hover:opacity-90 transition-all">
            Edit Package
          </button>
          <button class="flex-1 py-2 px-4 border border-muted rounded-lg hover:bg-muted/50 transition-all">
            Download PDF
          </button>
        </div>
      </div>
    </section>

    <!-- Next Steps Sidebar -->
    <aside class="space-y-6">
      <div class="p-6 border border-muted rounded-2xl bg-muted/30 space-y-4">
        <h3 class="font-bold">Finalize Your Event</h3>
        <p class="text-sm opacity-60">To lock in your date and finalize the menu, we move to direct communication.</p>
        
        <a 
          href="https://instagram.com/beandream" 
          target="_blank"
          class="block w-full py-3 px-4 bg-[#E1306C] text-white text-center font-semibold rounded-lg hover:opacity-90 transition-all"
        >
          Message us on Instagram
        </a>
        <p class="text-[10px] text-center opacity-40">Standard response time: 4-6 hours</p>
      </div>
    </aside>
  </div>
</div>
</BaseLayout>
