---
/**
 * Headquarters Page
 * Secondary landing page for the physical tasting room.
 */
---
import BaseLayout from '../layouts/BaseLayout.astro';

<BaseLayout title="The Tasting Room | Bean & Dream">
  <main class="w-full min-h-screen bg-background text-on-surface py-24 px-6 sm:px-12 flex justify-center">
    <div class="max-w-3xl w-full text-center">
      <h1 class="font-serif text-5xl sm:text-6xl mb-6">The Tasting Room</h1>
      <p class="font-sans text-xl text-on-surface/70 leading-relaxed mb-12">
        Our physical headquarters serves as a trusted sanctuary and tasting room, 
        grounding our mobile catering services in authenticity and craft.
      </p>
      <div class="aspect-video bg-surface rounded-3xl overflow-hidden mb-12">
        <div class="w-full h-full flex items-center justify-center text-on-surface/30 italic">
        [ Tasting Room Visuals / Gallery ]
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 text-left">
        <div class="p-6 bg-surface rounded-2xl">
          <h3 class="font-serif text-2xl mb-2">Visit Us</h3>
          <p class="font-sans text-on-surface/60">Dunggo-an, Danao City, Cebu</p>
        </div>
        <div class="p-6 bg-surface rounded-2xl">
          <h3 class="font-serif text-2xl mb-2">Hours</h3>
          <p class="font-sans text-on-surface/60">Sat & Sun, 09:00 PM – 11:00 PM</p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
