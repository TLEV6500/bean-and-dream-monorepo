---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReservationForm from '../components/ReservationForm.astro';
---
<BaseLayout>
  <section class="text-center py-12">
    <h2 class="font-cormorant text-3xl sm:text-4xl text-[#F5F3EF]">Reserve Your Spot</h2>
    <p class="text-[#B8B5AE] mt-4">Fill in the details below to secure your reservation for our pop‑up stand.</p>
    <ReservationForm />
  </section>
</BaseLayout>
