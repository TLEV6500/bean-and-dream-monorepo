---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceOverview from '../components/ServiceOverview.astro';
import MenuList from '../components/MenuList.astro';
import MatchaList from '../components/MatchaList.astro';
---
<BaseLayout>
  <Hero />
  
  <!-- Asymmetric Service Overview replaces the previous linear sections -->
  <ServiceOverview />

  <!-- Keep MenuLists as secondary detailed exploration -->
  <section class="w-full py-24 bg-background border-t border-surface-container-high/20">
    <div class="max-w-7xl mx-auto px-6 sm:px-12 grid grid-cols-1 lg:grid-cols-2 gap-12">
      <MenuList />
      <MatchaList />
    </div>
  </section>
</BaseLayout>
