---
import { useState } from 'preact/hooks';

let initialState = {
  name: '',
  email: '',
  phone: '',
  eventDate: '',
};

function validateForm(data) {
  const errors = {};
  if (!data.name.trim()) errors.name = 'Name required';
  if (!data.email.trim()) errors.email = 'Email required';
  else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) errors.email = 'Invalid email';
  if (!data.phone.trim()) errors.phone = 'Phone required';
  if (!data.eventDate) errors.eventDate = 'Date required';
  return errors;
}
---

<form onsubmit={(e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = {
    name: formData.get('name'),
    email: formData.get('email'),
    phone: formData.get('phone'),
    eventDate: formData.get('eventDate'),
    submittedAt: new Date().toISOString(),
  };
  const errors = validateForm(data);
  if (Object.keys(errors).length) {
    // Display first error (simple); can be improved
    alert(Object.values(errors)[0]);
    return;
  }
  // Send to pseudo API endpoint; here we simply log and show success
  alert('Reservation submitted!');
}} class="reservation-form flex flex-col gap-4 w-full max-w-md mx-auto mt-8">
  <label class="block">
    <span class="text-sm font-medium text-gray-700">Name</span>
    <input name="name" type="text" class="mt-1 block w-full rounded border-gray-300" required />
  </label>
  <label class="block">
    <span class="text-sm font-medium text-gray-700">Email</span>
    <input name="email" type="email" class="mt-1 block w-full rounded border-gray-300" required />
  </label>
  <label class="block">
    <span class="text-sm font-medium text-gray-700">Phone</span>
    <input name="phone" type="tel" class="mt-1 block w-full rounded border-gray-300" required />
  </label>
  <label class="block">
    <span class="text-sm font-medium text-gray-700">Preferred Date</span>
    <input name="eventDate" type="date" class="mt-1 block w-full rounded border-gray-300" required />
  </label>
  <button type="submit" class="px-4 py-2 bg-primary text-white rounded hover:bg-primary-dark">Submit</button>
</form>