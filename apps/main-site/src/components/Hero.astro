---
/**
 * Hero Component
 * High-impact entry point for the conversion engine.
 */
const hero = {
  title: "Bespoke Mobile Catering for High‑End Events",
  subtitle: "Premium coffee, matcha, pastries and craft drinks delivered on‑site. Build your custom package now.",
  buttonLabel: "Start Building Your Package",
  buttonLink: "/builder",
  image: "/assets/demo/scene.avif",
};
---
<section class="flex flex-col items-center justify-between w-full h-screen relative">
  <!-- Background Image with overlay -->
  <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url(${hero.image});`}>
    <div class="absolute inset-0 bg-black/60" />
  </div>
  <!-- Content -->
  <div class="relative z-10 text-center text-on-surface max-w-2xl px-6 mx-auto">
    <p class="font-serif text-6xl sm:text-7xl font-bold mb-4">{hero.title}</p>
    <p class="font-sans text-2xl sm:text-3xl mb-8">{hero.subtitle}</p>
    <a href={hero.buttonLink}
      class="inline-block bg-primary text-on-primary py-3 px-8 rounded-full font-medium hover:bg-primary-dark">{hero.buttonLabel}</a>
  </div>
</section>
