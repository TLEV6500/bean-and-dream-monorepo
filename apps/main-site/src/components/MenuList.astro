---
const items = [
  { name: "Ethiopian Yirgacheffe", price: "₱150.00", img: "/assets/demo/coffee.avif" },
  { name: "Colombian Supremo", price: "₱140.00", img: "/assets/demo/coffee.avif" },
  { name: "Vietnamese Robusta Blend", price: "₱130.00", img: "/assets/demo/coffee.avif" },
  { name: "Dark Roast House Blend", price: "₱160.00", img: "/assets/demo/coffee.avif" },
];
---
<section class="menu-container">
  <h2 class="font-cormorant text-xl sm:text-4xl text-[#F5F3EF] font-normal tracking-tight mb-4">
    Our Coffee Beans
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {items.map(item => (
      <div class="bg-surface p-4 rounded-lg shadow-md overflow-hidden">
        <img src={item.img} alt={item.name} class="w-full h-48 object-cover rounded-lg" />
        <div class="mt-3">
          <h3 class="font-cormorant text-lg tracking-tighter mb-1">{item.name}</h3>
          <p class="text-xl font-medium text-primary">{item.price}</p>
        </div>
      </div>
    ))}
  </div>
</section>
