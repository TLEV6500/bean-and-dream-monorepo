---
// Components for the builder configuration inputs
// Following the "Premium Mobile F&B" brand identity: tactile, minimalist, high-contrast.
---

<div class="space-y-12">
  <!-- Guest Count Section -->
  <section class="space-y-4">
    <label for="guest-count" class="block text-sm font-medium uppercase tracking-wider opacity-60">
      Estimated Guest Count
    </label>
    <div class="relative max-w-xs">
      <input 
        type="number" 
        id="guest-count" 
        name="guest-count" 
        min="1" 
        placeholder="e.g. 50"
        class="w-full px-4 py-3 bg-transparent border-b-2 border-muted focus:border-primary outline-none text-2xl transition-colors"
        aria-label="Enter estimated guest count"
      />
      <span class="absolute right-0 bottom-3 text-xs opacity-40">Guests</span>
    </div>
  </section>

  <!-- Base Tier Selection -->
  <section class="space-y-4">
    <label class="block text-sm font-medium uppercase tracking-wider opacity-60">
      Select Base Experience
    </label>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" role="radiogroup" aria-label="Base Service Tiers">
      <!-- Tier 1 -->
      <label class="relative group cursor-pointer">
        <input type="radio" name="base-tier" value="essential" class="peer sr-only" checked />
        <div class="p-6 border-2 border-muted rounded-xl transition-all peer-checked:border-primary peer-checked:bg-primary/5 group-hover:border-primary/50">
          <div class="flex justify-between items-start mb-2">
            <h4 class="font-bold text-lg">The Essential Cart</h4>
            <span class="text-sm font-mono">$15 / guest</span>
          </div>
          <p class="text-sm opacity-60">Core specialty coffee and matcha service. Perfect for intimate gatherings.</p>
        </div>
      </label>

      <!-- Tier 2 -->
      <label class="relative group cursor-pointer">
        <input type="radio" name="base-tier" value="premium" class="peer sr-only" />
        <div class="p-6 border-2 border-muted rounded-xl transition-all peer-checked:border-primary peer-checked:bg-primary/5 group-hover:border-primary/50">
          <div class="flex justify-between items-start mb-2">
            <h4 class="font-bold text-lg">The Alchemist's Suite</h4>
            <span class="text-sm font-mono">$25 / guest</span>
          </div>
          <p class="text-sm opacity-60">Expanded menu including signature craft drinks and premium pastry pairings.</p>
        </div>
      </label>
    </div>
  </section>

  <!-- Premium Add-ons -->
  <section class="space-y-4">
    <label class="block text-sm font-medium uppercase tracking-wider opacity-60">
      Premium Inclusions
    </label>
    <div class="space-y-3">
      <!-- Add-on 1 -->
      <label class="flex items-center p-4 border border-muted rounded-xl cursor-pointer hover:bg-primary/5 transition-colors group">
        <div class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" name="addon" value="single-origin" class="sr-only peer" />
          <div class="w-11 h-6 bg-muted rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
        </div>
        <div class="ml-4 flex justify-between items-center w-full">
          <div>
            <span class="block font-medium">Single-Origin Reserve</span>
            <span class="text-xs opacity-60">Seasonal rotating micro-lots</span>
          </div>
          <span class="text-sm font-mono">+$5 / guest</span>
        </div>
      </label>

      <!-- Add-on 2 -->
      <label class="flex items-center p-4 border border-muted rounded-xl cursor-pointer hover:bg-primary/5 transition-colors group">
        <div class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" name="addon" value="bespoke-branding" class="sr-only peer" />
          <div class="w-11 h-6 bg-muted rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
        </div>
        <div class="ml-4 flex justify-between items-center w-full">
          <div>
            <span class="block font-medium">Bespoke Branding</span>
            <span class="text-xs opacity-60">Custom cup sleeves and menu signage</span>
          </div>
          <span class="text-sm font-mono">+$200 flat</span>
        </div>
      </label>
    </div>
  </section>
</div>
