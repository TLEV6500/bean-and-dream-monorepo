{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
          "dependsOn": ["^build"],
          "outputs": [".cloudflare/**", "dist/**"]
        },
        "deploy:staging": {
          "dependsOn": ["build"],
          "cache": false
        },
        "deploy:production": {
          "dependsOn": ["build"],
          "cache": false
        },
        "dev": {
          "persistent": true,
          "cache": false,
        },
        "test": {
            "dependsOn": ["build"],
            "outputs": []
        }
      }
}
