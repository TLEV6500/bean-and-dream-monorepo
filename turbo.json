{
    "$schema": "https://turborepo.dev/schema.json",
    "globalPassThroughEnv": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_ENV"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                ".cloudflare/**",
                "dist/**"
            ]
        },
        "deploy": {
            "dependsOn": [
                "build"
            ],
            "cache": false
        },
        "dev": {
            "persistent": true,
            "cache": false,
        },
        "test": {
            "dependsOn": [
                "build"
            ],
            "outputs": []
        },
        "lint": {
            "inputs": [
                "src/**/*",
                ".eslintrc*",
                "eslint.config.*"
            ],
            "outputs": []
        },
        "typecheck": {
            "inputs": [
                "src/**/*",
                "tsconfig.json"
            ],
            "outputs": []
        },
        "pre-commit": {
            "dependsOn": [
                "lint",
                "typecheck"
            ]
        }
    }
}
